  CONTROL "", IDC_DUPLICATE_LIST, "RICHEDIT50W",
          WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_BORDER | WS_VSCROLL |
          WS_HSCROLL | ES_LEFT | ES_MULTILINE | ES_AUTOVSCROLL |
          ES_AUTOHSCROLL | ES_READONLY | ES_NOHIDESEL,
          8, 36, 404, 196
  PUSHBUTTON "", IDCANCEL, 360, 238, 52, 14
